{
  "name": "wanderly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@prisma/client": "6.16.2"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:typecheck": "tsc --noEmit -p prisma/tsconfig.json",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx --test prisma/seed-data/places.test.ts",
    "api:validate": "node scripts/validate-openapi.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@apidevtools/swagger-parser": "12.1.0",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}
