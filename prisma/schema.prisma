generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum PreferenceSource {
  ONBOARDING
  EXPLICIT
  LEARNED
}

enum PlaceProvider {
  INTERNAL
  GOOGLE
}

enum PlaceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum IndoorOutdoor {
  INDOOR
  OUTDOOR
  MIXED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum PlanType {
  PERSONAL
  GROUP
  SURPRISE
}

enum PlanStatus {
  DRAFT
  GENERATED
  FINALIZED
  COMPLETED
  CANCELLED
}

enum TravelMode {
  WALK
  BIKE
  DRIVE
  TRANSIT
}

enum PlanItemSource {
  GENERATED
  MANUAL
  REPLACED
}

enum FeedbackType {
  LOVED
  OKAY
  DISLIKED
  SKIP
  REPLACE
  VISITED
}

enum AiInteractionType {
  EXTRACT
  EXPLAIN
  MODIFY
}

enum InteractionStatus {
  SUCCESS
  FAILED
  FALLBACK
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(320)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  role            UserRole         @default(USER)
  status          UserStatus       @default(ACTIVE)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  profile         UserProfile?
  sessions        UserSession[]
  preferences     UserPreference[]
  favorites       Favorite[]
  reviews         Review[]
  plans           Plan[]
  feedbacks       UserFeedback[]
  aiInteractions  AiInteraction[]
  auditLogs       AdminAuditLog[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String   @map("display_name") @db.VarChar(100)
  avatarUrl     String?  @map("avatar_url")
  phone         String?  @db.VarChar(30)
  homeLatitude  Decimal? @map("home_latitude") @db.Decimal(9, 6)
  homeLongitude Decimal? @map("home_longitude") @db.Decimal(9, 6)
  timezone      String   @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  locale        String   @default("vi-VN") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Category {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(100)
  icon            String?          @db.VarChar(100)
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  userPreferences UserPreference[]
  places          PlaceCategory[]

  @@index([isActive, name])
  @@map("categories")
}

model UserPreference {
  userId     String           @map("user_id") @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  weight     Decimal          @default(1) @db.Decimal(5, 4)
  source     PreferenceSource
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_preferences")
}

model Place {
  id                     String             @id @default(uuid()) @db.Uuid
  provider               PlaceProvider      @default(INTERNAL)
  providerPlaceId        String?            @map("provider_place_id") @db.VarChar(255)
  name                   String             @db.VarChar(255)
  slug                   String             @unique @db.VarChar(300)
  description            String?
  address                String
  district               String?            @db.VarChar(100)
  city                   String             @db.VarChar(100)
  countryCode            String             @map("country_code") @db.Char(2)
  latitude               Decimal            @db.Decimal(9, 6)
  longitude              Decimal            @db.Decimal(9, 6)
  rating                 Decimal?           @db.Decimal(3, 2)
  reviewCount            Int                @default(0) @map("review_count")
  priceMin               BigInt?            @map("price_min")
  priceMax               BigInt?            @map("price_max")
  typicalDurationMinutes Int?               @map("typical_duration_minutes")
  indoorOutdoor          IndoorOutdoor      @map("indoor_outdoor")
  popularityScore        Decimal            @default(0) @map("popularity_score") @db.Decimal(5, 4)
  status                 PlaceStatus        @default(DRAFT)
  providerPayload        Json?              @map("provider_payload")
  lastSyncedAt           DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)
  categories             PlaceCategory[]
  images                 PlaceImage[]
  openingHours           PlaceOpeningHour[]
  favorites              Favorite[]
  reviews                Review[]
  planItems              PlanItem[]
  feedbacks              UserFeedback[]
  events                 Event[]

  @@unique([provider, providerPlaceId])
  @@index([city, status])
  @@index([rating(sort: Desc)])
  @@index([priceMin, priceMax])
  @@index([provider, lastSyncedAt])
  @@map("places")
}

model PlaceCategory {
  placeId    String   @map("place_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  relevance  Decimal  @default(1) @db.Decimal(5, 4)
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId, placeId])
  @@map("place_categories")
}

model PlaceImage {
  id          String   @id @default(uuid()) @db.Uuid
  placeId     String   @map("place_id") @db.Uuid
  url         String
  attribution String?
  sortOrder   Int      @default(0) @map("sort_order")
  isCover     Boolean  @default(false) @map("is_cover")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
  @@map("place_images")
}

model PlaceOpeningHour {
  id        String    @id @default(uuid()) @db.Uuid
  placeId   String    @map("place_id") @db.Uuid
  dayOfWeek Int       @map("day_of_week") @db.SmallInt
  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, dayOfWeek])
  @@map("place_opening_hours")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@map("favorites")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  placeId   String       @map("place_id") @db.Uuid
  rating    Int          @db.SmallInt
  content   String?
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Plan {
  id                      String          @id @default(uuid()) @db.Uuid
  ownerUserId             String?         @map("owner_user_id") @db.Uuid
  title                   String          @db.VarChar(255)
  planType                PlanType        @default(PERSONAL) @map("plan_type")
  status                  PlanStatus      @default(DRAFT)
  timezone                String          @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  startTime               DateTime        @map("start_time") @db.Timestamptz(6)
  endTime                 DateTime        @map("end_time") @db.Timestamptz(6)
  peopleCount             Int             @map("people_count")
  budget                  BigInt?
  currency                String          @default("VND") @db.Char(3)
  startLatitude           Decimal?        @map("start_latitude") @db.Decimal(9, 6)
  startLongitude          Decimal?        @map("start_longitude") @db.Decimal(9, 6)
  maxTravelRadiusMeters   Int?            @map("max_travel_radius_meters")
  inputText               String?         @map("input_text")
  constraints             Json
  estimatedCost           BigInt          @default(0) @map("estimated_cost")
  estimatedDistanceMeters Int             @default(0) @map("estimated_distance_meters")
  estimatedTravelMinutes  Int             @default(0) @map("estimated_travel_minutes")
  matchScore              Decimal?        @map("match_score") @db.Decimal(5, 4)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                   User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  items                   PlanItem[]
  shares                  PlanShare[]
  feedbacks               UserFeedback[]
  aiInteractions          AiInteraction[]

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([status, startTime])
  @@map("plans")
}

model PlanItem {
  id                    String         @id @default(uuid()) @db.Uuid
  planId                String         @map("plan_id") @db.Uuid
  placeId               String         @map("place_id") @db.Uuid
  orderIndex            Int            @map("order_index")
  startTime             DateTime       @map("start_time") @db.Timestamptz(6)
  endTime               DateTime       @map("end_time") @db.Timestamptz(6)
  estimatedCost         BigInt         @default(0) @map("estimated_cost")
  travelMode            TravelMode?    @map("travel_mode")
  travelDistanceMeters  Int            @default(0) @map("travel_distance_meters")
  travelDurationMinutes Int            @default(0) @map("travel_duration_minutes")
  matchScore            Decimal?       @map("match_score") @db.Decimal(5, 4)
  recommendationReason  String?        @map("recommendation_reason")
  weatherSnapshot       Json?          @map("weather_snapshot")
  source                PlanItemSource
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan                  Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  place                 Place          @relation(fields: [placeId], references: [id], onDelete: Restrict)
  feedbacks             UserFeedback[]

  @@unique([planId, orderIndex])
  @@index([planId, startTime])
  @@map("plan_items")
}

model PlanShare {
  id        String    @id @default(uuid()) @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_shares")
}

model UserFeedback {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  planId       String?      @map("plan_id") @db.Uuid
  planItemId   String?      @map("plan_item_id") @db.Uuid
  placeId      String?      @map("place_id") @db.Uuid
  feedbackType FeedbackType @map("feedback_type")
  rating       Int?         @db.SmallInt
  comment      String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  planItem     PlanItem?    @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  place        Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_feedbacks")
}

model AiInteraction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  planId          String?           @map("plan_id") @db.Uuid
  interactionType AiInteractionType @map("interaction_type")
  provider        String            @db.VarChar(50)
  model           String            @db.VarChar(100)
  promptVersion   String            @map("prompt_version") @db.VarChar(50)
  inputRedacted   Json?             @map("input_redacted")
  outputJson      Json?             @map("output_json")
  inputTokens     Int?              @map("input_tokens")
  outputTokens    Int?              @map("output_tokens")
  latencyMs       Int               @map("latency_ms")
  status          InteractionStatus
  errorCode       String?           @map("error_code") @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan            Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_interactions")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  placeId     String?     @map("place_id") @db.Uuid
  title       String      @db.VarChar(255)
  description String?
  startTime   DateTime    @map("start_time") @db.Timestamptz(6)
  endTime     DateTime    @map("end_time") @db.Timestamptz(6)
  priceMin    BigInt?     @map("price_min")
  priceMax    BigInt?     @map("price_max")
  bookingUrl  String?     @map("booking_url")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  place       Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([startTime, endTime])
  @@map("events")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}
