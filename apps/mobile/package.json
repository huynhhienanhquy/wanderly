{
  "name": "@wanderly/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "cross-env EXPO_NO_TELEMETRY=1 expo export --platform web",
    "config:check": "cross-env EXPO_NO_TELEMETRY=1 expo config --type public",
    "smoke:check": "pnpm typecheck && pnpm test",
    "dev": "expo start",
    "lint": "tsc --noEmit",
    "start": "expo start",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "dependencies": {
    "@wanderly/contracts": "workspace:*",
    "expo": "54.0.0",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "3.0.8",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-css-interop": "^0.2.6",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "cross-env": "10.0.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "tailwindcss": "3.4.17"
  }
}
